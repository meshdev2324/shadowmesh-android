// Tri-state encoding for a diagnostic that may not have run.
//
// A bare boolean for "captive portal detected" cannot distinguish "we looked
// and found none" from "we never looked". It was initialised to false and never
// assigned again, so the UI reported a clean result for a check that had never
// been performed. On a censorship tool that is false reassurance, so these
// fields are nullable instead:
//
//   null - the check did not run, or the platform cannot perform it
//   0   - the check ran and found nothing
//   1   - the check ran and found a problem
//
// Modelled as a nullable u8 rather than an enum because the generated bindings
// did not resolve an enum referenced from a dictionary; a nullable integer
// carries the identical three states and cannot be mis-constructed.
dictionary NetworkReport {
    boolean is_connected;
    NetworkType network_type;

    // Mean round-trip latency over the probes that SUCCEEDED, or null when
    // fewer than two of the five probes succeeded (F68).
    //
    // This is the one field in this dictionary whose null does NOT mean "the
    // scan did not run" -- that is `is_connected`. Null here means "we did not
    // gather enough samples to publish a defensible mean". A single surviving
    // probe is not a latency figure: publishing it at full value would make a
    // degrading link look better, since less averaging survives the worse the
    // link gets.
    //
    // Read it together with `packet_loss` below, which is denominated over all
    // five probes and is populated whenever the link is up at all.
    //
    // NOTE: this measures the control plane, not the tunnel. The rename to
    // `control_plane_rtt_ms` is deliberately NOT done yet -- it is sequenced
    // after F68 and requires L7's read-out contract (F52/F67).
    u32? latency_ms;
    u32? jitter_ms;

    // Probe loss over all five probes, 0.0 to 1.0. Unlike `latency_ms` this
    // keeps the full denominator, so it stays honest exactly when the latency
    // figure has been withheld.
    f32? packet_loss;
    SpeedTestResult? speed_test;
    ServerNetworkReport? server_report;
    u8? captive_portal;
    u8? dpi_detected;
    boolean dpi_detected_by_server;
    boolean is_protected;
};dictionary IdentityInfo {
    i64 id;
    string public_key;
    boolean is_admin;
    boolean mfa_enabled;
    string created_at;
};

dictionary ServerNetworkReport {
    string client_ip;
    string geoip; // JSON string
    boolean potential_dpi;
    u8 security_score;
    string recommendation;
};

callback interface SocketProtector {
  boolean protect(i32 fd);
};

interface NetworkDetector {
    [Throws=ShadowMeshError]
    NetworkReport detect(boolean run_speed_test);
};

interface VPNManager {
  [Throws=ShadowMeshError]
  void activate(string code, string? token, string? plan, i32 devices_remaining, i64 remaining_days);
  boolean is_activated();
  ConnectionStatus get_status();
  void set_selected_node(VPNNode node);
  VPNNode? get_selected_node();
  void set_nodes(sequence<VPNNode> nodes);
  void refresh_node_latencies();
  void set_traffic_mode(TrafficMode mode);
  sequence<VPNNode> get_nodes();
  VPNNode? get_best_node();
  [Throws=ShadowMeshError]
  void initiate_connection(VPNNode node, string device_public_key);
  void complete_connection();
  void disconnect();
  boolean is_connection_timed_out();
  TrafficMode? get_current_connection_mode();
  UserSettings get_user_settings();
  void set_kill_switch_enabled(boolean enabled);
  boolean is_kill_switch_enabled();
  void set_traffic_mode_preference(TrafficModePreference preference);
  TrafficModePreference get_traffic_mode_preference();
  ConnectionStats get_stats();
  void set_stats(ConnectionStats stats);
  ProtocolStats get_protocol_stats();
  [Throws=ShadowMeshError]
  void pause(u32 minutes);
  void resume();
  boolean check_pause_expiry();
  i64? get_paused_until();
  SplitTunnelConfig get_split_tunnel_config();
  void set_split_tunnel_config(SplitTunnelConfig config);
  void set_dpi_detected(boolean detected);
  boolean is_dpi_detected();
  void set_baseline_ip(string ip);
  string? get_baseline_ip();
  ServicePlan get_plan();
  i32 get_devices_remaining();
  i64 get_remaining_days();
  boolean is_ebpf_active();
  void zeroize();
  void panic_wipe();
};

interface ApiClient {
  void set_device_id(string device_id);
  void set_auth_token(string? token);
  void set_traffic_mode(TrafficMode? mode);
  void set_pow_solution(string solution, string original_challenge);
  void set_retry_signal(boolean retry);
  [Throws=ShadowMeshError]
  NodeRoster get_nodes();
  [Throws=ShadowMeshError]
  NodeRoster get_nodes_resilient();
  [Throws=ShadowMeshError]
  GlobalManifest fetch_global_manifest();
  [Throws=ShadowMeshError]
  ActivationChallenge request_activation_challenge(string device_id);
  [Throws=ShadowMeshError]
  ActivationResponse activate(ActivationRequest req);
  [Throws=ShadowMeshError]
  VPNConfig get_config(string node_id, string public_key, string? mode);
  [Throws=ShadowMeshError]
  HeartbeatResponse heartbeat(
    HeartbeatRequest req
  );
  [Throws=ShadowMeshError]
  void pause_session();
  [Throws=ShadowMeshError]
  void revoke_session();
  [Throws=ShadowMeshError]
  void report_compromised(string device_id, string reason);
  [Throws=ShadowMeshError]
  string refresh_token();
  [Throws=ShadowMeshError]
  HealthStatus check_health();
  [Throws=ShadowMeshError]
  SecurityManifest fetch_security_manifest();
  [Throws=ShadowMeshError]
  string qr_generate(string device_id, string device_name, string os_name, string os_version, string arch);
  [Throws=ShadowMeshError]
  string qr_status(string token);
  [Throws=ShadowMeshError]
  void qr_authorize(string token);
  [Throws=ShadowMeshError]
  IdentityInfo get_identity_info();
  [Throws=ShadowMeshError]
  string setup_totp_begin(); // Returns JSON as string for now
  [Throws=ShadowMeshError]
  void setup_totp_finish(string code);
  [Throws=ShadowMeshError]
  string generate_member_token(string label);
  [Throws=ShadowMeshError]
  string passkey_register_begin(string username);
  [Throws=ShadowMeshError]
  void passkey_register_finish(string username, string response_json);
  [Throws=ShadowMeshError]
  string passkey_login_start(string username);
  [Throws=ShadowMeshError]
  ActivationResponse passkey_login_finish(string username, string response_json);
  [Throws=ShadowMeshError]
  void log_security_event(string event_json);
  void zeroize();
};

interface NodeCache {
