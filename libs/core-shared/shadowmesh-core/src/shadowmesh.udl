  void put(VPNNode node);
  void put_all(sequence<VPNNode> nodes);
  sequence<VPNNode> get_all();
  f64 hit_rate();
  [Throws=ShadowMeshError]
  void save_to_disk(string path);
  void clear();
};

interface KillSwitchManager {
  boolean is_active();
  boolean is_lockout();
  void set_lockout(boolean enabled);
  boolean is_feature_enabled(string feature);
  void set_feature_enabled(string feature, boolean enabled);
  [Throws=ShadowMeshError]
  void check_remote(ApiClient client);
  void trigger_kill_switch(string reason);
  void deactivate_kill_switch();
  void set_fallback_mode(boolean enabled);
  boolean is_fallback_mode();
  sequence<KillSwitchEvent> get_audit_log();
  void save_state_to_cache(KillSwitchState state);
  KillSwitchState? get_cached_state();
};

interface TrafficAnalytics {
  void record_stats(string server_id, ConnectionStats stats);
  u64 get_total_bytes();
  u64 get_bytes_this_month();
  void reset_month();
};

interface SpeedTest {
  [Throws=ShadowMeshError]
  SpeedTestResult run_full_test();
  [Throws=ShadowMeshError]
  f64 measure_latency();
  [Throws=ShadowMeshError]
  f64 measure_download(u32 size_kb);
  [Throws=ShadowMeshError]
  f64 measure_upload(u32 size_kb);
};

interface DesktopController {
  constructor(ApiClient api_client, VPNManager vpn_manager);
  [Throws=ShadowMeshError]
  void authenticate_member(string member_token);
  [Throws=ShadowMeshError]
  string create_member_token(string label);
};

namespace shadowmesh {
  string? normalize_activation_code(string raw);
  UserSettings get_default_user_settings();
  [Throws=ShadowMeshError]
  SecurityEventLogger create_security_logger(string device_id, string app_version, string storage_dir);
  [Throws=ShadowMeshError]
  sequence<string> generate_wireguard_keys();
  // RFC-026 §8b: the code-seeded KDF (`generate_device_wireguard_keys`) was
  // removed here rather than deprecated. Its output was an X25519 *private*
  // key computed from a user-typable, plan-shared secret, so the function was
  // itself the vulnerability. Do not reintroduce any entry point that maps a
  // shared or user-supplied string to key material; per-device identity comes
  // from the CSPRNG and is persisted (RFC-026 §4.1).
  [Throws=ShadowMeshError]
  VPNConfig parse_wireguard_config(string config_str);
  // ⚠️ `sequence<VPNNode> get_mock_nodes();` WAS HERE, and it is GONE.
  //
  // The core carried a **literal fabricated row** — `id:"mock-1"`,
  // `name:"Mock Node 1"`, `endpoint:"1.1.1.1:51820"`,
  // `public_key:"mock-pub-key-1"` — and exported it over the FFI. The
  // iOS client's fallback consumed exactly this literal, so the next
  // consumer could re-introduce a fabricated roster with one call.
  //
  // ⇒ **A fabrication source in the core is a trap for the next consumer.**
  // The literal now lives in the TEST tree only
  // (`libs/…/tests/common/mod.rs`), and the FFI no longer exports it, so
  // the export cannot be reached from a client at all.
  [Throws=ShadowMeshError]
  PoWSolution solve_pow(PoWChallenge challenge);
  [Throws=ShadowMeshError]
  VPNManager create_vpn_manager(UserSettings settings);
  string get_persistent_device_id();
  void setup_logging();
  [Throws=ShadowMeshError]
  ApiClient create_api_client(string base_url);
  [Throws=ShadowMeshError]
  ApiClient create_api_client_with_pins(string base_url, sequence<string> pinned_hashes);
  [Throws=ShadowMeshError]
  NodeCache create_node_cache(u32 max_size, u32 ttl_seconds);
  [Throws=ShadowMeshError]
  KillSwitchManager create_kill_switch_manager();
  [Throws=ShadowMeshError]
  TrafficAnalytics create_traffic_analytics();
  TrafficPreferences create_traffic_preferences();
  SpeedTest create_speed_test(ApiClient api_client);
  NetworkDetector create_network_detector(ApiClient api_client, VPNManager? manager);

// Phase 4: Shadow-Routing & Quantum Tunneling (PROTOCOLS.md §1, §2, §3)
  VPNNode? shadow_route_best_node(sequence<VPNNode> nodes);
  string preferred_traffic_mode_for_region(string region_code);
  bytes decrypt_qr_pairing_payload(bytes ciphertext, string pin);
  bytes encrypt_qr_pairing_payload(bytes plaintext, string pin);
  // F98: the refusal is now an EXCEPTION the consumer must handle, not a
  // sentinel value it must know to check. The empty string was the refusal
  // before this, and a sentinel that is a legal value in the type is not a
  // refusal (RFC-049 §6.2 item 14).
  [Throws=ShadowMeshError]
  string generate_reality_short_id();
  RealityConfig? parse_reality_vless_uri(string uri);
  string generate_dh_private_key();
  string compute_dh_public_key(string private_key_hex);
  string compute_dh_shared_secret(string private_key_hex, string other_public_key_hex);
  string derive_session_token(string dh_shared_secret_hex);
  u32 get_quantum_mtu();
  u32 get_quantum_tcp_mss();
  [Throws=ShadowMeshError]
  AttestationReport get_mock_attestation_report(string nonce);

// v6.9.4: Socket Protection (Infinite Loop Fix)
  void register_socket_protector(SocketProtector protector);

// v6.2: High-Censorship Resilience (Unified Engine)
  // ⚠️ DEPRECATED (RFC-048 §3.6) — RETAINED, NOT REMOVED.
  //
  // The two-phase path below (connect_transport → attach_tun) replaces this
  // one-call establishment. The removal condition is: "no FFI consumer
  // remains AND the tracked .so has been rebuilt without the symbol".
  // Removing a UDL entry does NOT remove the symbol from a shipped .so
  // (scripts/ci/check-udl-binary-drift.sh, blocking direction), and the
  // tracked .so cannot be rebuilt until F46's freshness gate exists — so the
  // removal is blocked on F46, not on this deprecation.
  [Throws=ShadowMeshError]
  void start_vpn_engine(i32 fd, VPNConfig config);
  void stop_vpn_engine();

  // ── RFC-048 ─────────────────────────────────────────────────────────────────
  // Two-phase transport establishment. Additive: the signatures of
  // start_vpn_engine and stop_vpn_engine are unchanged.
  //
  // connect_transport proves the transport with NO tun descriptor. The client
  // installs its capture only after this returns. attach_tun then hands the
  // descriptor to the already-connected transport.
  //
  // FROZEN 2026-10-20 by RFC-048 §3.1. Changing any of these three signatures
  // requires a new RFC: the Android client's call order depends on them.
  [Throws=ShadowMeshError]
  u64 connect_transport(VPNConfig config);

  [Throws=ShadowMeshError]
  void attach_tun(u64 handle, i32 fd);

  // Not [Throws]: a teardown path must not raise. Returns whether the caller
  // owned the session it asked to close.
  boolean close_transport(u64 handle);

  [Throws=ShadowMeshError]
  void start_reality_proxy(RealityConfig config, u16 local_port);
  void stop_reality_proxy();
};

